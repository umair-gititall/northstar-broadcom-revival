include $(TOPDIR)/rules.mk
include $(INCLUDE_DIR)/kernel.mk

PKG_NAME:=broadcom-wl
PKG_VERSION:=6.37.14.126
PKG_RELEASE:=1

PKG_LICENSE:=Proprietary
PKG_LICENSE_FILES:=vendor/README.md
PKG_MAINTAINER:=Project Argon

PKG_BUILD_PARALLEL:=1

include $(INCLUDE_DIR)/package.mk

define Package/broadcom-wl/Default
  SECTION:=net
  CATEGORY:=Network
  SUBMENU:=Wireless
  URL:=https://github.com/
endef

# The kernel module. FILES is the artifact kbuild leaves behind; KernelPackage
# copies it to /lib/modules/$(LINUX_VERSION)/ and records the exact-kernel
# dependency for us.
define KernelPackage/broadcom-wl
  $(call Package/broadcom-wl/Default)
  TITLE:=Broadcom wl closed-source driver (blob port)
  DEPENDS:=@TARGET_bcm53xx
  FILES:=$(PKG_BUILD_DIR)/wl.ko
  AUTOLOAD:=
endef

define KernelPackage/broadcom-wl/description
  Broadcom's proprietary 802.11ac driver (BCM4360/BCM4331 radios on
  BCM4708/4709 SoCs), repackaged to run against the stock OpenWrt kernel.

  This is the FreshTomato 6.37.14.126 binary linked through a translation
  layer (objcopy symbol interposition + shadow structures) - it is not
  rebuilt from source. See README.md for the mechanism and licensing.
endef

# Userspace and OpenWrt integration (netifd handler, init, hotplug,
# uci-defaults). Depends on the module so the two always move together.
define Package/broadcom-wl
  $(call Package/broadcom-wl/Default)
  TITLE:=Broadcom wl userspace tools and OpenWrt integration
  DEPENDS:=+kmod-broadcom-wl
endef

define Package/broadcom-wl/description
  wlconf, wldiag, eapd, nas and the prebuilt `wl` control tool, plus the
  netifd wireless handler and init/hotplug glue that let LuCI configure the
  broadcom wl driver through /etc/config/wireless (option type 'broadcom').
endef

# Source is this directory: no PKG_SOURCE, so Build/Prepare copies the tree in.
# Generated build products (.o, .ko, wl.mod.c, modules.order, ...) are left
# behind on purpose - only the shadow sources, Kbuild and the vendored trees
# are needed. wl_apsta.o_shipped is (re)generated by the objcopy step below.
define Build/Prepare
	rm -rf $(PKG_BUILD_DIR)
	$(INSTALL_DIR) $(PKG_BUILD_DIR)
	$(CP) -a $(CURDIR)/Kbuild $(CURDIR)/Makefile.standalone \
		$(CURDIR)/wl_shadow*.c $(CURDIR)/wl_shadow*.h \
		$(CURDIR)/wl_shim_removed.c \
		$(CURDIR)/shadow $(CURDIR)/vendor $(CURDIR)/userspace \
		$(PKG_BUILD_DIR)/
	# Drop artifacts a previous standalone build left in the tree, so the
	# sub-makes cannot mistake a host- or stale-compiled object for current.
	# vendor/wl/linux/wl_apsta.o and vendor/wl/arm-uclibc/wl are *inputs*,
	# not artifacts, and are deliberately not touched.
	-find $(PKG_BUILD_DIR)/userspace -name '*.o' -delete
	-rm -f $(PKG_BUILD_DIR)/vendor/libnvram/*.o $(PKG_BUILD_DIR)/vendor/libnvram/*.so
	-rm -f $(PKG_BUILD_DIR)/vendor/libshared/*.o $(PKG_BUILD_DIR)/vendor/libshared/*.so
	-rm -f $(PKG_BUILD_DIR)/userspace/uclibc-compat/wl $(PKG_BUILD_DIR)/userspace/uclibc-compat/uclibc.so
endef

# Four steps, in order:
#   1. objcopy the blob (Makefile.standalone) into wl_apsta.o_shipped;
#   2. kbuild the module (Kbuild reads vendor/, shadow/ beside it);
#   3. the two vendored userspace libraries;
#   4. the tools, which link against those libraries.
#
# OBJCOPY is passed explicitly: the blob must be relinked with the *target*
# binutils, not the host's (a host objcopy silently produces an object the
# cross-linker then rejects).
define Build/Compile
	+$(MAKE) -C $(PKG_BUILD_DIR) -f Makefile.standalone \
		OBJCOPY="$(TARGET_CROSS)objcopy" wl_apsta.o_shipped
	+$(KERNEL_MAKE) $(PKG_JOBS) M="$(PKG_BUILD_DIR)" modules
	+$(MAKE) -C $(PKG_BUILD_DIR)/vendor/libnvram \
		CC="$(TARGET_CC)" CFLAGS="$(TARGET_CFLAGS)"
	+$(MAKE) -C $(PKG_BUILD_DIR)/vendor/libshared \
		CC="$(TARGET_CC)" CFLAGS="$(TARGET_CFLAGS)"
	+$(MAKE) -C $(PKG_BUILD_DIR) -f Makefile.standalone userspace \
		CC="$(TARGET_CC)" AR="$(TARGET_CROSS)ar" CROSS_COMPILE="$(TARGET_CROSS)"
endef

define Package/broadcom-wl/install
	$(INSTALL_DIR) $(1)/usr/sbin $(1)/usr/lib $(1)/lib
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/userspace/wlconf/wlconf $(1)/usr/sbin/wlconf
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/userspace/wldiag/wldiag $(1)/usr/sbin/wldiag
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/userspace/eapd/eapd $(1)/usr/sbin/eapd
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/userspace/nas/nas $(1)/usr/sbin/nas
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/userspace/uclibc-compat/wl $(1)/usr/sbin/wl
	$(INSTALL_DATA) $(PKG_BUILD_DIR)/vendor/libnvram/libnvram.so $(1)/usr/lib/libnvram.so
	$(INSTALL_DATA) $(PKG_BUILD_DIR)/vendor/libshared/libshared.so $(1)/usr/lib/libshared.so

	# The uClibc-ABI shim. `wl` is a prebuilt uClibc binary; it loads this as
	# its libc (DT_NEEDED was rewritten libc.so.0 -> uclibc.so to dodge musl's
	# reserved-name resolution). ld-uClibc.so.0 is created in postinst against
	# whichever musl loader this build ships.
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/userspace/uclibc-compat/uclibc.so $(1)/lib/uclibc.so

	# Integration files. Every one is an executable script (init.d, hotplug,
	# uci-defaults, the netifd ucode handler, the ctl wrapper and the sourced
	# library), so install each with INSTALL_BIN: the exec bit is what makes
	# them run at boot and what lets netifd load the wireless handler. A plain
	# $(CP) would carry whatever mode the checkout happens to have.
	$(INSTALL_DIR) $(1)/usr/lib/broadcom-wl $(1)/lib/netifd/wireless
	$(INSTALL_DIR) $(1)/etc/init.d $(1)/etc/hotplug.d/iface $(1)/etc/uci-defaults
	$(INSTALL_BIN) ./files/usr/sbin/broadcom-wl-ctl $(1)/usr/sbin/broadcom-wl-ctl
	$(INSTALL_BIN) ./files/usr/lib/broadcom-wl/common.sh $(1)/usr/lib/broadcom-wl/common.sh
	$(INSTALL_BIN) ./files/lib/netifd/wireless/broadcom.sh $(1)/lib/netifd/wireless/broadcom.sh
	$(INSTALL_BIN) ./files/etc/init.d/broadcom-wl $(1)/etc/init.d/broadcom-wl
	$(INSTALL_BIN) ./files/etc/hotplug.d/iface/30-broadcom-wl $(1)/etc/hotplug.d/iface/30-broadcom-wl
	$(INSTALL_BIN) ./files/etc/uci-defaults/99-broadcom-wl $(1)/etc/uci-defaults/99-broadcom-wl
endef

define Package/broadcom-wl/postinst
#!/bin/sh
[ -n "$${IPKG_INSTROOT}" ] || {
	if [ ! -e /lib/ld-uClibc.so.0 ]; then
		loader="$$(ls /lib/ld-musl-*.so.1 2>/dev/null | head -n1)"
		[ -n "$$loader" ] && ln -sf "$$loader" /lib/ld-uClibc.so.0
	fi
}
exit 0
endef

# Put back any stock netifd wireless handler the package moved aside (see
# common.sh:handler-single for why), so removing the package restores a
# pristine system.
define Package/broadcom-wl/prerm
#!/bin/sh
[ -n "$${IPKG_INSTROOT}" ] || /usr/sbin/broadcom-wl-ctl handler-restore 2>/dev/null
exit 0
endef

$(eval $(call KernelPackage,broadcom-wl))
$(eval $(call BuildPackage,broadcom-wl))
