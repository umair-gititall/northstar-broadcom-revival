#!/bin/sh /etc/rc.common

START=50
USE_PROCD=1

start_service() {
	[ -x /usr/sbin/broadcom-wl-buttond ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/broadcom-wl-buttond
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	return 0
}
