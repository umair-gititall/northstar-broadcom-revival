# Kept from when this lived inside the tomato64 tree, whose top-level
# .gitignore has a bare "src/" - meant for the buildroot checkout at /src, but
# written without a leading slash, so it matched a directory named src at ANY
# depth and silently swallowed the Broadcom sources under userspace/*/src and
# vendor/shared/bcmwifi/src. Harmless here, and cheap insurance if this tree is
# ever vendored back into a repo that ignores src/ again.
!**/src/

# Build products. The vendored SOURCES are tracked deliberately (see
# vendor/README.md); what the build makes from them is not.
/wl_apsta.o_shipped
*.o
*.a
*.ko
*.mod
*.mod.c
.*.cmd
/Module.symvers
/modules.order
/.tmp_versions/
/userspace/wlconf/wlconf
/userspace/wldiag/wldiag
/userspace/eapd/eapd
/userspace/nas/nas
/userspace/uclibc-compat/uclibc.so
/userspace/uclibc-compat/wl

# Vendored-library build outputs (their sources are tracked).
/vendor/libnvram/libnvram.so
/vendor/libshared/libshared.so

# Release artifacts.
/dist/

# The proprietary blobs are NOT tracked: Broadcom's driver object and the
# prebuilt `wl` tool ship no source, and this repo does not redistribute them.
# fetch.sh retrieves them from the vendor's published source at a pinned,
# hash-verified revision; see vendor/README.md. (wl_apsta.o would be caught by
# the *.o rule above anyway - it is listed for the reader, and so that a future
# rule cannot silently re-include it.)
/vendor/wl/linux/wl_apsta.o
/vendor/wl/up/wl_apsta.o
/vendor/wl/arm-uclibc/wl
