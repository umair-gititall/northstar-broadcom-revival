# Vendored from tomato64/package/libshared/shared.
#
# Built for the bcm53xx platform only: TCONFIG_BCMARM + TCONFIG_RTNPLUS are
# baked into tomato_config.h (generated by gen_tomato_config.h.sh) and the
# wl<N>_* private-ioctl ABI as well as wsec_info_t's layout depend on them.
# wlif_utils.o is compiled in for BCM53XX, exactly as upstream does; it provides
# get_wsec(), get_ifname_by_wlmac() and wl_wlif_is_psta().
#
# Upstream also links usb.o and ndpi.o, which in turn pull the busybox
# util-linux/volume_id objects. Those are omitted here: none of the wl tools
# (wlconf, wldiag, eapd, nas) touch USB or deep-packet-inspection, and linking
# an executable against a libshared.so that carries volume_id_* undefined would
# fail - the executable link resolves every undefined symbol in the .so, unlike
# the .so link itself.
CC     ?= cc
CFLAGS ?= -O2 -Wall

ALL_CPPFLAGS = -fPIC -std=gnu17 -DTOMATO64 -DBCMARM \
	       -I. -Iinclude -Icommon/include -Ibcmwifi/include $(CPPFLAGS)
ALL_CFLAGS   = -fPIC $(CFLAGS)
ALL_LDFLAGS  = -fPIC $(LDFLAGS)

OBJS = shutils.o wl.o wl_linux.o linux_timer.o defaults.o id.o misc.o \
       led.o led_sysfs.o version.o base64.o files.o strings.o process.o \
       nvparse.o bb_uuid.o wlif_utils.o

all: libshared.so

libshared.so: $(OBJS)
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(ALL_LDFLAGS) -shared -o $@ $^

# Matches upstream: defaults.c is built with the SDK6 wl defaults for BCM53XX.
defaults.o: defaults.c
	$(CC) $(ALL_CPPFLAGS) -DCONFIG_BCMWL5 -DCONFIG_BCMWL6 $(ALL_CFLAGS) -c -o $@ $<

%.o: %.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) -c -o $@ $<

# tomato_config.h / tomato_version.h are not removed: they are generated by the
# gen_*.sh scripts, not by make, so deleting them here would break a rebuild.
clean:
	rm -f *.o libshared.so

.PHONY: all clean
